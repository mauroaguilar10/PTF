---
// Página simple de título + texto. Servicios y Sobre mí arrancan así y crecen en las etapas 1 y 2.
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang, RouteKey, UiKey } from '../i18n/ui';
import { otherLang, path, useTranslations } from '../i18n/utils';

interface Props {
  lang: Lang;
  page: RouteKey;
  titleKey: UiKey;
  bodyKeys: UiKey[]; // un párrafo por clave
}

const { lang, page, titleKey, bodyKeys } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t(titleKey)} alternatePath={path(page, otherLang(lang))}>
  <h1>{t(titleKey)}</h1>
  <div class="prose">
    {bodyKeys.map((key) => <p>{t(key)}</p>)}
  </div>
  <slot />
</BaseLayout>

<style>
  .prose { max-width: 42rem; }
</style>
