---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { projectPath, useTranslations } from '../i18n/utils';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
  delay?: number; // retraso de la animación de entrada, en ms
}

const { project, lang, delay = 0 } = Astro.props;
const t = useTranslations(lang);
const slug = project.id.split('/').at(-1)!;
const { title, summary, status, stack } = project.data;
---

<article class="card spotlight" data-reveal style={`--delay: ${delay}ms`}>
  <span class="status" data-status={status}>{t(`projects.status.${status}`)}</span>
  <h3><a href={projectPath(slug, lang)}>{title}</a></h3>
  <p class="muted">{summary}</p>
  <ul class="stack">{stack.map((item) => <li>{item}</li>)}</ul>
  <span class="arrow" aria-hidden="true">→</span>
</article>

<style>
  .card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-4);
    transition: transform 0.4s var(--ease-out), border-color 0.4s, box-shadow 0.4s;
  }
  /* Brillo que sigue al puntero (posición en --mx / --my, ver spotlight.js) */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(380px circle at var(--mx, 50%) var(--my, -20%), var(--color-glow), transparent 60%);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .card:hover::before { opacity: 1; }
  .card:hover {
    transform: translateY(-4px);
    border-color: rgb(96 165 250 / 0.45);
    box-shadow: 0 20px 40px -20px var(--color-glow);
  }
  .card h3 { margin: var(--space-2) 0; }
  /* El enlace cubre toda la tarjeta */
  .card h3 a { color: var(--color-text); text-decoration: none; }
  .card h3 a::after { content: ''; position: absolute; inset: 0; }
  .card:focus-within { border-color: var(--color-accent-2); }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .status::before { content: ''; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: currentColor; }
  .status[data-status='publicado'] { color: var(--color-ok); }
  .status[data-status='en-desarrollo'] { color: var(--color-accent-2); }
  .stack { list-style: none; padding: 0; margin: var(--space-3) 0 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .stack li {
    font-size: 0.78rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    border-radius: 999px;
    padding: 0.15rem 0.65rem;
    color: var(--color-muted);
  }
  .arrow {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    color: var(--color-muted);
    transition: transform 0.4s var(--ease-out), color 0.4s;
  }
  .card:hover .arrow { transform: translateX(4px); color: var(--color-accent-2); }
</style>
